# Mission Control secret store. Copy to .env at the repo root and fill in.
# .env is gitignored (.env* rule); never commit real values.

# --- manifold (agents/manifold/) ----------------------------------------

# Superlearn Supabase project. URL is not secret; defaults to the live
# project if unset.
SUPABASE_URL=https://gijdjbjycymqsuhwfcbu.supabase.co

# Write access for manifold. The service role key is the intended credential
# (Supabase dashboard: Project Settings, API, service_role). Keep it here
# only; it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Stopgap only: the app's public anon key also works today because every
# Superlearn table ships an allow-all RLS policy (Superlearn repo,
# supabase/migrations/20260804000000_superlearn.sql). The moment those
# policies tighten, the anon key stops writing and the service key is
# required.
SUPABASE_ANON_KEY=

# Model for the editorial pass and the evals judge (judge overridable with
# MANIFOLD_JUDGE_MODEL). Sonnet-tier default.
MANIFOLD_MODEL=claude-sonnet-5

# Optional. When set, manifold calls the Anthropic API directly. When unset,
# it shells out to the local `claude` CLI (Claude Code auth), which is how
# this machine runs it today.
ANTHROPIC_API_KEY=

# Tuning, all optional.
# MANIFOLD_ITEM_CAP=120
# MANIFOLD_MAX_ATTEMPTS=2
# MANIFOLD_JUDGE_MODEL=
# SUPERLEARN_TENANT=default
# Rolling window (days) in which an outbox park excludes its items from
# lede and start_here candidacy.
# MANIFOLD_PARK_WINDOW_DAYS=90
# Below this many viable (non-excluded) items the editorial prompt asks for
# a smaller honest edition instead of padding.
# MANIFOLD_EDITION_FLOOR=3
